# The Lamb's Victory: static site (prerendered pages).
Options -Indexes
DirectorySlash Off
ErrorDocument 404 /__spa-fallback.html

RewriteEngine On

# Preview copies on Hostinger's temporary addresses must stay out of search engines.
SetEnvIfNoCase Host \.hostingersite\.com$ IS_PREVIEW
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=IS_PREVIEW
</IfModule>

# One canonical host and scheme.
RewriteCond %{HTTP_HOST} ^www\.thelambsvictory\.org$ [NC]
RewriteRule ^(.*)$ https://thelambsvictory.org/$1 [R=301,L]

# Old addresses.
RewriteRule ^the-first-beast/?$ /chapter-13/the-first-beast [R=301,L]
RewriteRule ^the-second-beast/?$ /chapter-13/the-second-beast [R=301,L]
RewriteRule ^mark-of-the-beast/?$ /chapter-13/mark-of-the-beast [R=301,L]
RewriteRule ^666-number-of-the-beast/?$ /chapter-13/666-number-of-the-beast [R=301,L]
RewriteRule ^forty-two-months/?$ /topics/forty-two-months [R=301,L]

# No trailing slash on page addresses.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

# /chapter-2 serves chapter-2/index.html without changing the address.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
